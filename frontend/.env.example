# ==============================================================================
# Phygital Store Frontend Environment Configuration
# ==============================================================================

# Backend API URLs
NEXT_PUBLIC_API_URL="http://localhost:3001"
INTERNAL_API_URL="http://127.0.0.1:3001"

# Midtrans Client Key (Mode Sandbox / Production)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="YOUR_MIDTRANS_CLIENT_KEY"
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION="true" # Set to "true" for Production or "false" for Sandbox

# Google Sign-In Client ID (Google Cloud Console -> APIs & Credentials)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# Cloudinary Unsigned Upload Preset (Direct Catalog & 3D Garment Uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your_unsigned_upload_preset"
