# ==============================================================================
# Database & Cache Configuration
# ==============================================================================
DATABASE_URL="postgresql://admin:YOUR_SECURE_PASSWORD@localhost:5435/phygital_db?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3001

# ==============================================================================
# Security & Environment Mode
# Set ke "production" saat live di server publik agar cookie HttpOnly Secure & CORS aktif ketat
# ==============================================================================
NODE_ENV="development"

# Domain Frontend resmi yang diizinkan mengakses backend (pisahkan koma jika lebih dari 1)
ALLOWED_ORIGINS="https://tokoanda.com,https://admin.tokoanda.com"
FRONTEND_URL="https://tokoanda.com"

# Kunci Rahasia JWT (Gunakan 64-karakter string acak unik di produksi)
# Buat string acak di terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="YOUR_RANDOM_64_CHAR_SUPER_SECRET_KEY"
JWT_EXPIRES_IN="1d"

# ==============================================================================
# Payment Gateway (Midtrans)
# ==============================================================================
MIDTRANS_SERVER_KEY="YOUR_MIDTRANS_SERVER_KEY"
MIDTRANS_CLIENT_KEY="YOUR_MIDTRANS_CLIENT_KEY"

# ==============================================================================
# SMTP Email (Nodemailer untuk OTP Reset Password & Notifikasi)
# ==============================================================================
# Opsi 1: Mode Development (Gmail SMTP)
SMTP_EMAIL="your_email@gmail.com"
SMTP_PASSWORD="your_google_app_password"

# Opsi 2: Mode Production (Brevo / Resend / SendGrid / Custom Domain SMTP)
# Jika SMTP_HOST diisi, backend otomatis menggunakan konfigurasi produksi ini:
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT=587
# SMTP_SECURE="false"
# SMTP_USER="your_brevo_login@domain.com"
# SMTP_PASSWORD="your_brevo_smtp_key"
# SMTP_FROM_NAME="Phygital Store"
# SMTP_FROM_EMAIL="noreply@domainanda.com"


# ==============================================================================
# Google OAuth Configuration
# ==============================================================================
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"


